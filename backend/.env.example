# Mẫu cấu hình backend — sao chép thành `.env` rồi điền giá trị thật.
#
# Thứ tự tìm file: `backend/.env` trước, rồi `<repo-root>/.env`
# (xem app/config.py, hàm _load_dotenv). KHÔNG commit file `.env` thật
# — nó đã nằm trong .gitignore. Mọi giá trị dưới đây đều là mặc định
# an toàn đã có sẵn trong code; comment khi cần bật.
#
# Chạy test (pytest) KHÔNG cần file .env và không cần SQL Server.

# --- SQL Server (bắt buộc để pending/history/moderation hoạt động) ---
SQL_MODE=sqlexpress
SQL_HOST=localhost
SQL_INSTANCE=SQLEXPRESS
SQL_DATABASE=VietNormalizer
# sql = SQL login (cần SQL_PASSWORD), windows = Windows Authentication
SQL_AUTH=sql
SQL_USERNAME=normalizer_app
SQL_PASSWORD=
# Chỉ đổi khi cài driver khác
# SQL_DRIVER="ODBC Driver 18 for SQL Server"
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
# SQL_ECHO=0

# --- Auth ---
# AUTH_SECRET bắt buộc >= 32 ký tự khi set. Để TRỐNG: backend tự sinh secret
# random cho từng process (đăng nhập vẫn chạy, nhưng token hết hiệu lực khi
# restart server). Sinh giá trị:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
APP_ENV=development
WEB_ORIGIN=http://localhost:5173
# ALLOW_DEV_AUTH_SECRET=0
# AUTH_TOKEN_TTL_MINUTES=120
# AUTH_MAX_FAILED_LOGINS=10
# AUTH_LOCKOUT_MINUTES=15

# --- AI NVIDIA (hoàn toàn opt-in: frontend mặc định tắt, không có key thì
#     luồng rule-based vẫn chạy bình thường) ---
# NVIDIA_API_KEY=
# NVIDIA_MODEL=z-ai/glm-5.3-flash
# SEMANTIC_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_PROVIDER=nvidia
# AI_DISABLE_NETWORK=0

# --- Rate limit / giới hạn live (mặc định khớp code, chỉ mở khi cần) ---
# RATE_LIMIT_ENABLED=1
# LIVE_MAX_PENDING_SUBMISSIONS=80
# MAX_REQUEST_BODY_BYTES=1048576
